# OTR Market Operation 3

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SECURE_COOKIE=0
# OTR_DB_PATH=data/otrmarket.db

# Required for NinjaTrader -> OTR market-data bridge.
# operation3_setup.sh generates this automatically in .env if blank.
OTR_BRIDGE_KEY=

# Legacy Operation 2 proxy feed credentials. No longer required by src.main.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Production hosting notes (Railway)
# Railway injects PORT automatically. Do not hardcode PORT in production.
# Mount a Railway Volume at /app/data so SQLite survives deploys/restarts.
# Recommended production values:
# DASHBOARD_SECURE_COOKIE=1
# DASHBOARD_PASSWORD=<set privately in Railway>
# DASHBOARD_SESSION_SECRET=<set privately in Railway>

# Operation 4.5 - prop-account training guard
# Defaults model a LucidPro 50K evaluation. OTR internal limits are stricter
# than the firm limits on purpose and should be tuned from replay statistics.
EVAL_GUARD_ENABLED=1
EVAL_PROFILE=LUCID_PRO_50K
EVAL_PHASE=EVALUATION
EVAL_START_BALANCE=50000
EVAL_PROFIT_TARGET=3000
EVAL_MAX_LOSS=2000
EVAL_FIRM_DAILY_LOSS=1200
EVAL_INITIAL_TRAIL_BALANCE=52100
EVAL_LOCKED_MLL_BALANCE=50100
EVAL_MAX_MICROS=40
EVAL_RISK_PER_TRADE=100
EVAL_MIN_RISK_PER_TRADE=25
EVAL_INTERNAL_DAILY_STOP=400
EVAL_MLL_SAFETY_BUFFER=400
EVAL_MAX_TRADES_PER_DAY=4
EVAL_MAX_CONSECUTIVE_LOSSES=3
EVAL_MAX_CONCURRENT=1
EVAL_NO_NEW_AFTER_ET=16:30
EVAL_RESUME_ET=18:00
