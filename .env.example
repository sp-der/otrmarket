# OTR Market Operation 7.2

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SECURE_COOKIE=0
# OTR_DB_PATH=data/otrmarket.db

# Required for NinjaTrader <-> OTR market/execution bridge.
OTR_BRIDGE_KEY=

# Operation 7.2 broker execution.
# Safe default: PAPER never emits executable broker commands.
# First certification mode at the PC should be SIM_BRIDGE + Sim101 only.
OTR_EXECUTION_MODE=PAPER
OTR_EXECUTION_ARMED=0
OTR_EXECUTION_ACCOUNT=Sim101
OTR_EXECUTION_MAX_MICROS=1
OTR_EXECUTION_MAX_RISK_DOLLARS=350
OTR_EXECUTION_COMMAND_TTL_SECONDS=45
OTR_EXECUTION_HEARTBEAT_TTL_SECONDS=15
OTR_EXECUTION_RECONCILIATION_TTL_SECONDS=15
OTR_EXECUTION_CLAIM_REDELIVERY_SECONDS=5
OTR_EXECUTION_KILL_SWITCH=0

# Live mode has independent interlocks and remains off during SIM certification.
OTR_EXECUTION_LIVE_ALLOWED=0
OTR_EXECUTION_CERTIFIED=0

# Legacy Operation 2 proxy feed credentials. No longer required by src.main.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Production hosting notes (Railway)
# Railway injects PORT automatically. Mount a Railway Volume at /app/data.
# DASHBOARD_SECURE_COOKIE=1
# DASHBOARD_PASSWORD=<set privately in Railway>
# DASHBOARD_SESSION_SECRET=<set privately in Railway>

# Prop-account training guard / fast-eval profile
EVAL_GUARD_ENABLED=1
EVAL_PROFILE=LUCID_PRO_50K
EVAL_PHASE=EVALUATION
EVAL_START_BALANCE=50000
EVAL_PROFIT_TARGET=3000
EVAL_MAX_LOSS=2000
EVAL_FIRM_DAILY_LOSS=1200
EVAL_INITIAL_TRAIL_BALANCE=52100
EVAL_LOCKED_MLL_BALANCE=50100
EVAL_MAX_MICROS=40
# Operation 7.2E exposes up to $500 to the grade-aware paper sizing layer.
# Final paper caps are A+ $500, A $350, B+ $100; lower session/reversal caps still win.
EVAL_RISK_PER_TRADE=500
EVAL_MIN_RISK_PER_TRADE=100
EVAL_INTERNAL_DAILY_STOP=750
EVAL_MLL_SAFETY_BUFFER=400
EVAL_MAX_TRADES_PER_DAY=8
EVAL_MAX_CONSECUTIVE_LOSSES=2
EVAL_MAX_CONCURRENT=1
EVAL_SESSION_PROFIT_CAP=1500
EVAL_NO_NEW_AFTER_ET=16:30
EVAL_RESUME_ET=18:00
EVAL_CONTINUE_AFTER_TARGET=0

# Multi-timeframe autonomous execution
OTR_SESSION_TZ=America/New_York
OTR_EXECUTION_TIMEFRAME=ALL
# Full-risk core session.
OTR_SESSION_START=09:30
OTR_SESSION_END=13:00
# Qualified setups can execute at reduced risk in the broader window.
OTR_EXTENDED_SESSION_START=08:30
OTR_EXTENDED_SESSION_END=15:30
OTR_ENGINE_MODULE=src.main_72
OTR_CALIBRATION_MAX_TRADES_DAY=2
OTR_BASE_WIN_LOCK_DOLLARS=250
OTR_SECOND_CHANCE_MIN_RR=2.0
OTR_SECOND_CHANCE_BODY_RATIO=1.90
OTR_SECOND_CHANCE_RANGE_RATIO=1.50

# Fast-eval non-overlapping session buckets in America/New_York:
# Asia 18:00-21:00, Tokyo 21:00-02:00, London 02:00-08:00,
# New York 08:00-16:30. 16:30-18:00 remains the maintenance lock.

# Bounded raw tick retention
OTR_QUOTE_RETENTION_NQ=50000
OTR_QUOTE_RETENTION_ES=50000
OTR_QUOTE_RETENTION_GC=50000
OTR_QUOTE_RETENTION_BTC_USD=10000
OTR_QUOTE_PRUNE_EVERY=5000
OTR_RUNTIME_DIR=/tmp/otrmarket