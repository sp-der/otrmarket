# OTR Market Operation 8.1

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SECURE_COOKIE=0
# OTR_DB_PATH=data/otrmarket.db

# NinjaTrader <-> OTR bridge
OTR_BRIDGE_KEY=

# Canonical runtime
OTR_ENGINE_MODULE=src.main_81
OTR_TRADING_MODE=EVAL
OTR_RUNTIME_DIR=/tmp/otrmarket

# Execution gateway. Keep these safe defaults for local/replay work.
OTR_EXECUTION_MODE=PAPER
OTR_EXECUTION_ARMED=0
OTR_EXECUTION_ACCOUNT=Sim101
OTR_EXECUTION_LIVE_ALLOWED=0
OTR_EXECUTION_CERTIFIED=0
OTR_EXECUTION_KILL_SWITCH=0
# Contract ceiling for LIVE/SIM_BRIDGE broker orders. ExecutionConfig defaults
# this to 1 when unset (fail-safe: an unarmed deployment must never size a real
# order). 40 is the value the Operation 8.1 envelope assumes.
OTR_EXECUTION_MAX_MICROS=40
# Paper/replay contract ceiling used by src/execution/paper.py size_whole_contract.
# Resolution order: OTR_PAPER_MAX_MICROS -> OTR_EXECUTION_MAX_MICROS ->
# EVAL_MAX_MICROS -> 40. Set this explicitly: the research ledger silently ran
# at 1 contract whenever OTR_EXECUTION_MAX_MICROS was left unset, which made
# replay P&L ~1/25th of the intended scale.
OTR_PAPER_MAX_MICROS=40
OTR_EXECUTION_MAX_RISK_DOLLARS=750
OTR_EXECUTION_COMMAND_TTL_SECONDS=45
OTR_EXECUTION_HEARTBEAT_TTL_SECONDS=15
OTR_EXECUTION_RECONCILIATION_TTL_SECONDS=15
OTR_EXECUTION_CLAIM_REDELIVERY_SECONDS=5

# Operation 8.1 evaluation envelope. Final A+/A sizing is enforced by
# src/otr8/execution_policy81.py ($750 / $500), not by this file alone.
EVAL_GUARD_ENABLED=1
EVAL_START_BALANCE=50000
EVAL_PROFIT_TARGET=3000
EVAL_MAX_LOSS=2000
EVAL_FIRM_DAILY_LOSS=1200
EVAL_RISK_PER_TRADE=750
EVAL_MIN_RISK_PER_TRADE=500
EVAL_INTERNAL_DAILY_STOP=1000
EVAL_MAX_CONCURRENT=1
EVAL_CONTINUE_AFTER_TARGET=1
# Undocumented-but-active gates. Both default ON and both stop new risk for the
# rest of the trading day / session even though OPERATION-8.1 documents
# "no session profit ceiling" and lists no consecutive-loss breaker. Set the
# profit cap to 0 for measurement-only, and the loss breaker to 0 to disable.
EVAL_SESSION_PROFIT_CAP=1500
EVAL_MAX_CONSECUTIVE_LOSSES=3

# Session / timeframe context
OTR_SESSION_TZ=America/New_York
OTR_EXECUTION_TIMEFRAME=ALL
OTR_SESSION_START=09:30
OTR_SESSION_END=13:00
OTR_EXTENDED_SESSION_START=08:30
OTR_EXTENDED_SESSION_END=15:30

# NautilusTrader shadow referee. Non-authoritative by design.
OTR_NAUTILUS_SHADOW=0
OTR_NAUTILUS_STRICT_PARITY=0
OTR_NAUTILUS_RECORD_MATCHES=0

# Research-ledger execution frictions (src/execution/paper.py).
# GROSS (default, historical): every stop fills exactly at the stop price and
# no commission or fees are charged, so reported expectancy is an upper bound.
# REALISTIC: stop exits slip OTR_PAPER_STOP_SLIPPAGE_TICKS ticks and gap through
# the stop when price prints beyond it, plus per-contract round-turn costs.
# Turn this on before judging whether the strategy is actually profitable.
# OTR_PAPER_COST_MODEL=REALISTIC
# OTR_PAPER_STOP_SLIPPAGE_TICKS=1
# OTR_PAPER_ROUND_TURN_COMMISSION=1.24
# OTR_PAPER_ROUND_TURN_FEES=0.36

# Bounded raw-tick retention. Current autonomous focus is GC; NQ/ES values
# remain available for inherited context/research paths.
OTR_QUOTE_RETENTION_NQ=50000
OTR_QUOTE_RETENTION_ES=50000
OTR_QUOTE_RETENTION_GC=50000
OTR_QUOTE_PRUNE_EVERY=5000

# Railway supplies PORT automatically and should mount its persistent volume at
# /app/data. Set dashboard secrets privately in Railway, never in this file.

# Vibe-Trading research sidecar (non-authoritative)
# Enabled automatically on Railway; set 0 to disable. The actual AI loop waits
# safely until a provider/model and its private provider credential are set.
OTR_VIBE_RESEARCH=1
OTR_VIBE_PROVIDER=
OTR_VIBE_MODEL=
OTR_VIBE_POLL_SECONDS=3
OTR_VIBE_MAX_ITER=12
OTR_VIBE_TIMEOUT_SECONDS=180
# A RETRY job is claimable while attempts < OTR_VIBE_MAX_ATTEMPTS; once
# exhausted it becomes a terminal ERROR instead of retrying forever.
OTR_VIBE_MAX_ATTEMPTS=3
# Base delay (seconds) before a RETRY job is claimed again. Doubles per
# attempt up to a fixed internal cap so a flaky provider is never hammered.
OTR_VIBE_RETRY_BACKOFF_SECONDS=30
# Never commit provider credentials here. Set them privately in Railway.

# Operation 8.1 overnight replay reset. Leave empty to preserve all data
# (the safe default). Set to a new, non-empty value only when an operator
# explicitly intends to wipe the active paper/run tables for a fresh
# overnight scorecard; the same value applied twice is a no-op, and the
# reset refuses to run while a PENDING/OPEN paper position exists.
OTR_OPERATION81_RESET_TOKEN=
