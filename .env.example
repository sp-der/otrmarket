# OTR Market Operation 3

# Dashboard settings
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8000
DASHBOARD_PASSWORD=
DASHBOARD_SESSION_SECRET=
DASHBOARD_SECURE_COOKIE=0
# OTR_DB_PATH=data/otrmarket.db

# Required for NinjaTrader -> OTR market-data bridge.
# operation3_setup.sh generates this automatically in .env if blank.
OTR_BRIDGE_KEY=

# Legacy Operation 2 proxy feed credentials. No longer required by src.main.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Production hosting notes (Railway)
# Railway injects PORT automatically. Do not hardcode PORT in production.
# Mount a Railway Volume at /app/data so SQLite survives deploys/restarts.
# Recommended production values:
# DASHBOARD_SECURE_COOKIE=1
# DASHBOARD_PASSWORD=<set privately in Railway>
# DASHBOARD_SESSION_SECRET=<set privately in Railway>

# Operation 4.5 - prop-account training guard
# Defaults model a LucidPro 50K evaluation. OTR internal limits are stricter
# than the firm limits on purpose and should be tuned from replay statistics.
EVAL_GUARD_ENABLED=1
EVAL_PROFILE=LUCID_PRO_50K
EVAL_PHASE=EVALUATION
EVAL_START_BALANCE=50000
EVAL_PROFIT_TARGET=3000
EVAL_MAX_LOSS=2000
EVAL_FIRM_DAILY_LOSS=1200
EVAL_INITIAL_TRAIL_BALANCE=52100
EVAL_LOCKED_MLL_BALANCE=50100
EVAL_MAX_MICROS=40
EVAL_RISK_PER_TRADE=250
EVAL_MIN_RISK_PER_TRADE=250
EVAL_INTERNAL_DAILY_STOP=750
EVAL_MLL_SAFETY_BUFFER=400
EVAL_MAX_TRADES_PER_DAY=4
EVAL_MAX_CONSECUTIVE_LOSSES=3
EVAL_MAX_CONCURRENT=1
EVAL_NO_NEW_AFTER_ET=16:30
EVAL_RESUME_ET=18:00
EVAL_CONTINUE_AFTER_TARGET=1

# Operation 5.1 - focused replay session + consistency calibration
# The strategy still scans every timeframe, but only the selected execution
# timeframe may become a paper trade. Other candidates remain shadow research.
# No trade is ever forced merely to satisfy a daily quota.
OTR_SESSION_TZ=America/New_York
OTR_EXECUTION_TIMEFRAME=5m
OTR_SESSION_START=09:30
OTR_SESSION_END=13:00
OTR_CALIBRATION_MAX_TRADES_DAY=2
OTR_BASE_WIN_LOCK_DOLLARS=250
OTR_SECOND_CHANCE_MIN_RR=2.0
OTR_SECOND_CHANCE_BODY_RATIO=1.90
OTR_SECOND_CHANCE_RANGE_RATIO=1.50

# Operation 4.5.2 - bounded raw tick retention
# Candles/setups/trades persist indefinitely; only raw market_quotes roll over.
OTR_QUOTE_RETENTION_NQ=50000
OTR_QUOTE_RETENTION_ES=50000
OTR_QUOTE_RETENTION_GC=50000
OTR_QUOTE_RETENTION_BTC_USD=10000
OTR_QUOTE_PRUNE_EVERY=5000
# Runtime PID metadata lives on ephemeral storage, not the persistent volume.
OTR_RUNTIME_DIR=/tmp/otrmarket
